{
  "name": "noam-xp-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:emulator": "npm run rules:check && firebase emulators:exec --project demo-noam-xp-quest --only firestore \"vitest run --config vitest.emulator.config.ts\"",
    "emulators": "firebase emulators:start --project demo-noam-xp-quest --only firestore",
    "rules:sync": "node scripts/sync-firestore-semesters.mjs",
    "rules:check": "node scripts/sync-firestore-semesters.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "firebase": "^13.3.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.36.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}

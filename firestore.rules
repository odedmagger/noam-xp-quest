rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BEGIN GENERATED SEMESTER CONFIG
    function knownSemester(id) { return id in ["2026-a","2026-b"]; }
    function activeSemester(id) { return id == "2026-a"; }
    function activeStatusKeys() { return ["math:studied","math:mastery","math:excellent","english:studied","english:mastery","english:excellent","science:studied","science:mastery","science:excellent","hebrew:studied","hebrew:mastery","hebrew:excellent"]; }
    function activeRewardKeys() { return ["robux-small","game","robux-large","vbucks"]; }
    // END GENERATED SEMESTER CONFIG

    function validProgress(data) {
      return data.keys().hasAll(['schemaVersion', 'statuses', 'claims', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'statuses', 'claims', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.statuses is map && data.statuses.values().hasOnly(['pending', 'achieved', 'failed'])
        && data.claims is map && data.claims.values().hasOnly([true])
        && data.updatedAt == request.time;
    }

    // The prototype grants public access only to configured semester documents.
    match /semesters/{semesterId} {
      allow get: if knownSemester(semesterId);
      allow create: if activeSemester(semesterId) && validProgress(request.resource.data)
        && request.resource.data.statuses.keys().hasOnly(activeStatusKeys())
        && request.resource.data.claims.keys().hasOnly(activeRewardKeys());
      allow update: if activeSemester(semesterId) && validProgress(request.resource.data)
        && request.resource.data.statuses.diff(resource.data.statuses).removedKeys().size() == 0
        && request.resource.data.statuses.diff(resource.data.statuses).affectedKeys().hasOnly(activeStatusKeys())
        && request.resource.data.claims.diff(resource.data.claims).removedKeys().size() == 0
        && request.resource.data.claims.diff(resource.data.claims).affectedKeys().hasOnly(activeRewardKeys());
    }
  }
}
